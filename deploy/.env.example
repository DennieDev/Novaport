# Read by every service in docker-compose.yml. Keep it readable by root only (chmod 600) and
# keep a copy of the keys somewhere else. Values are taken literally: no quotes.

NOVAPORT_PUBLIC_URL=https://novaport.example.com
# Subnet of the traefik network: docker network inspect traefik -f '{{(index .IPAM.Config 0).Subnet}}'
NOVAPORT_TRUSTED_PROXIES=10.0.0.0/8
NOVAPORT_AGENT_DNS=tasks.agent
NOVAPORT_COMMIT_NAME=Novaport
NOVAPORT_COMMIT_EMAIL=novaport@example.com

# openssl rand -hex 32
NOVAPORT_AGENT_TOKEN=
# docker run --rm ghcr.io/denniedev/novaport generate-key
NOVAPORT_SECRET_KEY=
# docker run --rm ghcr.io/denniedev/novaport generate-age-key
# The AGE-SECRET-KEY-... line. The public key goes in .sops.yaml.
NOVAPORT_AGE_KEY=
# 12 characters or more. Only read while there are no users.
NOVAPORT_INITIAL_ADMIN_PASSWORD=

# openssl rand -hex 24, the same password in both lines.
# Postgres only reads it when it creates the database.
POSTGRES_PASSWORD=
NOVAPORT_DATABASE_URL=postgresql+asyncpg://novaport:password@postgres:5432/novaport
