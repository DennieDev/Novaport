# Read by every service in docker-compose.yml. Keep it readable by root only (chmod 600) and
# keep a copy of the keys somewhere else. Values are taken literally: no quotes.

SWARMER_PUBLIC_URL=https://swarmer.example.com
# Subnet of the traefik network: docker network inspect traefik -f '{{(index .IPAM.Config 0).Subnet}}'
SWARMER_TRUSTED_PROXIES=10.0.0.0/8
SWARMER_AGENT_DNS=tasks.agent
SWARMER_COMMIT_NAME=Swarmer
SWARMER_COMMIT_EMAIL=swarmer@example.com

# openssl rand -hex 32
SWARMER_AGENT_TOKEN=
# docker run --rm ghcr.io/dennielabs/swarmer generate-key
SWARMER_SECRET_KEY=
# docker run --rm ghcr.io/dennielabs/swarmer generate-age-key
# The AGE-SECRET-KEY-... line. The public key goes in .sops.yaml.
SWARMER_AGE_KEY=
# 12 characters or more. Only read while there are no users.
SWARMER_INITIAL_ADMIN_PASSWORD=

# openssl rand -hex 24, the same password in both lines.
# Postgres only reads it when it creates the database.
POSTGRES_PASSWORD=
SWARMER_DATABASE_URL=postgresql+asyncpg://swarmer:password@postgres:5432/swarmer
